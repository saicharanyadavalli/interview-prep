# ============================================================
# Interview Practice Platform - Root Deployment Environment Template
# Place as interview-app/.env on your EC2 host instance
# Secure permissions after creation: chmod 600 .env
# ============================================================

# ── 1. Google Gemini AI Service ─────────────────────────────
# Required for the AI doubt-clearing assistant (/api/backend/assistant/ask)
# Get from: https://aistudio.google.com/apikey
# Runtime variable read by FastAPI backend on container startup.
GEMINI_API_KEY=your_gemini_api_key_here

# ── 2. Amazon Cognito User Pool & Authentication ────────────
# Authoritative authentication provider for user identity, Google OAuth federation, and session tokens.
# Client tokens are verified by FastAPI backend against the Cognito JWKS endpoint (RS256).
# Application data is authoritatively stored in Amazon RDS PostgreSQL.
#
# Environment Guidelines:
# - Region: ap-south-2 (Hyderabad)
# - Personal Environment:
#     COGNITO_REGION=ap-south-2
#     COGNITO_USER_POOL_ID=ap-south-2_xxxxxxxxx
#     COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
#     COGNITO_DOMAIN=interview-prep-auth-personal.auth.ap-south-2.amazoncognito.com
# - Production Environment:
#     COGNITO_REGION=ap-south-2
#     COGNITO_USER_POOL_ID=ap-south-2_yyyyyyyyy
#     COGNITO_CLIENT_ID=yyyyyyyyyyyyyyyyyyyyyyyyyy
#     COGNITO_DOMAIN=auth.interviewprep.com (or interview-prep-auth.auth.ap-south-2.amazoncognito.com)
COGNITO_REGION=ap-south-2
COGNITO_USER_POOL_ID=ap-south-2_yourUserPoolId
COGNITO_CLIENT_ID=your_cognito_app_client_id
COGNITO_DOMAIN=your-cognito-domain.auth.ap-south-2.amazoncognito.com

# ── 2b. Supabase Authentication (OBSOLETE / REMOVED) ─────────
# ⚠️ DEPRECATED & REMOVED: Supabase Auth has been completely migrated to Amazon Cognito.
# These variables are obsolete and no longer used in active runtime.
# Do NOT enable or supply these in production.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your_supabase_anon_key_here
# SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ── 2c. Amazon RDS PostgreSQL & AWS Secrets Manager ───────────
# Authoritative application datastore for all application tables.
# On AWS EC2, credentials are dynamically resolved from Secrets Manager using the instance IAM role.
AWS_REGION=ap-south-2
RDS_SECRET_NAME=interview-prep/rds/app
# Optional: Explicit secret ARN override (defaults to resolving by RDS_SECRET_NAME)
# RDS_SECRET_ARN=arn:aws:secretsmanager:<region>:<account-id>:secret:<secret-name>
RDS_POOL_MIN=2
RDS_POOL_MAX=10

# Optional: Local / CI direct PostgreSQL connection override
# DATABASE_URL=postgresql://user:pass@localhost:5432/interview_prep_db

# ── 3. Google OAuth ─────────────────────────────────────────
# Optional: Google OAuth Client ID for direct frontend federation if configured.
# Primary Google OAuth is federated through Amazon Cognito Hosted UI.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── 4. AWS S3 & Amazon CloudFront (Static Assets & Avatars) ──
# Authoritative asset storage for profile avatars and system design diagrams.
# Static assets are delivered via CloudFront CDN distribution with low latency.
# On AWS EC2, the instance accesses S3 using the attached IAM role (InterviewPrepEC2Role).
#
# Environment Guidelines:
# - Staging Bucket: interview-prep-assets-808431466075-staging-ap-south-2
# - Personal Bucket: interview-prep-assets-808431466075-personal-ap-south-2
# - Production Bucket: interview-prep-assets-808431466075-production-ap-south-2
# - ASSET_BASE_URL: Actual HTTPS distribution domain (e.g. https://<your-distribution-id>.cloudfront.net)
#   ⚠️ STRICT REQUIREMENT: Do NOT use fictitious placeholder domains or unverified hostnames.
#   In personal/production, missing or invalid ASSET_BASE_URL will fail fast at runtime.
S3_ASSETS_BUCKET=interview-prep-assets-808431466075-personal-ap-south-2
S3_ASSETS_REGION=ap-south-2
ASSET_BASE_URL=https://<your-distribution-id>.cloudfront.net

# Optional asset folder prefixes (defaults shown)
S3_AVATAR_PREFIX=avatars
S3_SYSTEM_DESIGN_PREFIX=system-design

# ── 4b. Cloudinary (Media Storage - DEPRECATED) ───────────────
# Legacy image storage; replaced by Amazon S3 + CloudFront CDN.
# Retained temporarily for backward-compatibility during migration.
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── 5. Host Networking, CORS & URLs ─────────────────────────
# The public address where users access your application
# For initial testing: http://<EC2_PUBLIC_IP> (e.g., http://16.113.92.222)
# For production with SSL: https://app.interviewprep.com
FRONTEND_URL=https://app.interviewprep.com
PUBLIC_APP_ORIGIN=https://app.interviewprep.com

# Comma-separated list of allowed origins for FastAPI CORS
ALLOWED_ORIGINS=https://app.interviewprep.com,http://localhost:3000,http://127.0.0.1:3000

# ── 6. Frontend Build & Runtime Variables ────────────────────
# Relative API path routed via Nginx / Next.js BFF proxy to backend:8000
NEXT_PUBLIC_API_BASE_URL=/api/backend

# Obsolete Supabase frontend variables (REMOVED)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_DISABLE_AUTH=

# ── 7. Performance & Workers ────────────────────────────────
# Uvicorn ASGI worker count on EC2 instance (m7i-flex.large: 2 vCPUs, 8 GiB RAM)
# 2 workers recommended (1 worker per vCPU core)
UVICORN_WORKERS=2

# ── 8. Authentication Redirect URL & OAuth Callbacks ─────────
# Canonical redirect URL used for Cognito OAuth Hosted UI callbacks.
AUTH_REDIRECT_URL=https://app.interviewprep.com/auth/callback?next=/dashboard
NEXT_PUBLIC_AUTH_REDIRECT_URL=https://app.interviewprep.com/auth/callback?next=/dashboard
NEXT_PUBLIC_APP_URL=https://app.interviewprep.com

# ⚠️ COGNITO & GOOGLE OAUTH CONFIGURATION:
#
# 1. Amazon Cognito User Pool App Client Settings:
#    - Allowed callback URLs:
#        https://app.interviewprep.com/auth/callback
#        http://localhost:3000/auth/callback (local development)
#    - Allowed sign-out URLs:
#        https://app.interviewprep.com/login
#        http://localhost:3000/login
#    - Allowed OAuth flows: Authorization code grant (with PKCE)
#    - Allowed OAuth scopes: openid, email, profile
#    - Identity Providers: COGNITO, Google
#
# 2. Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs:
#    - Authorized redirect URIs:
#        https://<your-cognito-domain>.auth.ap-south-2.amazoncognito.com/oauth2/idpresponse
#      ⚠️ IMPORTANT: Google OAuth redirects directly to the Amazon Cognito Hosted UI domain
#      idpresponse endpoint, NOT directly to the EC2 application host. Cognito handles token
#      federation and redirects to the application /auth/callback with authorization code.
