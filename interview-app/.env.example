# ============================================================
# Interview Practice Platform - Root Deployment Environment Template
# Place as interview-app/.env on your EC2 host instance
# Secure permissions after creation: chmod 600 .env
# ============================================================

# ── 1. Google Gemini AI Service ─────────────────────────────
# Required for the AI doubt-clearing assistant (/api/backend/assistant/ask)
# Get from: https://aistudio.google.com/apikey
# Runtime variable read by FastAPI backend on container startup.
GEMINI_API_KEY=your_gemini_api_key_here

# ── 2. Supabase Cloud (Authentication Only) ───────────────────
# Required strictly for user identity, email/password auth, Google OAuth, and session tokens.
# Application data is authoritatively stored in Amazon RDS PostgreSQL.
# Get from: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ⚠️ SECRET: Service Role Key (Server-Side Backend ONLY)
# Used strictly by FastAPI to verify JWTs and manage Auth identities.
# NEVER expose this key to the frontend or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ── 2b. Amazon RDS PostgreSQL & AWS Secrets Manager ───────────
# Authoritative application datastore for all 11 application tables.
# On AWS EC2, credentials are dynamically resolved from Secrets Manager using the instance IAM role.
AWS_REGION=ap-south-2
RDS_SECRET_NAME=interview-prep/rds/app
# Optional: Explicit secret ARN override (defaults to resolving by RDS_SECRET_NAME)
# RDS_SECRET_ARN=arn:aws:secretsmanager:<region>:<account-id>:secret:<secret-name>
RDS_POOL_MIN=2
RDS_POOL_MAX=10

# Optional: Local / CI direct PostgreSQL connection override
# DATABASE_URL=postgresql://user:pass@localhost:5432/interview_prep_db

# ── 3. Google OAuth ─────────────────────────────────────────
# Required for Google Social Login (Optional if using email/password only)
# Get from: Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── 4. AWS S3 & Amazon CloudFront (Static Assets & Avatars) ──
# Authoritative asset storage for profile avatars and system design diagrams.
# Static assets are delivered via CloudFront CDN distribution with low latency.
# On AWS EC2, the instance accesses S3 using the attached IAM role (InterviewPrepEC2Role).
S3_ASSETS_BUCKET=interview-prep-assets-808431466075-ap-south-2
S3_ASSETS_REGION=ap-south-2
ASSET_BASE_URL=https://d123456abcdef8.cloudfront.net

# Optional asset folder prefixes (defaults shown)
S3_AVATAR_PREFIX=avatars
S3_SYSTEM_DESIGN_PREFIX=system-design

# ── 4b. Cloudinary (Media Storage - DEPRECATED) ───────────────
# Legacy image storage; replaced by Amazon S3 + CloudFront CDN.
# Retained temporarily for backward-compatibility during migration.
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── 5. Host Networking, CORS & URLs ─────────────────────────
# The public address where users access your application
# For initial testing: http://<EC2_PUBLIC_IP> (e.g., http://13.200.50.25)
# For production with SSL: https://your-domain.com
FRONTEND_URL=http://<EC2_PUBLIC_IP>

# Comma-separated list of allowed origins for FastAPI CORS
ALLOWED_ORIGINS=http://<EC2_PUBLIC_IP>,http://localhost:3000,http://127.0.0.1:3000

# ── 6. Frontend Build-Time Variables ────────────────────────
# ⚠️ IMPORTANT: NEXT_PUBLIC_* variables are inlined into client JavaScript bundles
# during Next.js image compilation ('docker compose build frontend').
# If you modify any NEXT_PUBLIC_* variable, you MUST rebuild the frontend image:
#   docker compose build frontend && docker compose up -d
NEXT_PUBLIC_API_BASE_URL=/api/backend
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_DISABLE_AUTH=false

# ── 7. Performance & Workers ────────────────────────────────
# Uvicorn ASGI worker count on EC2 instance (m7i-flex.large: 2 vCPUs, 8 GiB RAM)
# 2 workers recommended (1 worker per vCPU core)
UVICORN_WORKERS=2

# ── 8. Authentication Redirect URL (AWS EC2 Canonical) ───
# Canonical redirect URL used by Supabase Auth for OAuth callbacks and email confirmations.
# EC2: http://16.113.92.222/auth/callback?next=/dashboard (or http://<EC2_PUBLIC_IP>/auth/callback?next=/dashboard)
AUTH_REDIRECT_URL=http://<EC2_PUBLIC_IP>/auth/callback?next=/dashboard
FRONTEND_URL=http://<EC2_PUBLIC_IP>
NEXT_PUBLIC_AUTH_REDIRECT_URL=http://<EC2_PUBLIC_IP>/auth/callback?next=/dashboard
NEXT_PUBLIC_APP_URL=http://<EC2_PUBLIC_IP>

# ⚠️ CRITICAL GOOGLE CLOUD CONSOLE & SUPABASE OAUTH CONFIGURATION:
#
# 1. Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs:
#    - Authorized JavaScript origins:
#        http://16.113.92.222 (for staging IP testing)
#        https://your-domain.com (for production)
#    - Authorized redirect URIs:
#        https://<your-project-ref>.supabase.co/auth/v1/callback
#      ⚠️ IMPORTANT: Do NOT put http://16.113.92.222/auth/callback in Google Cloud Console.
#      Google OAuth must redirect to the Supabase Auth engine callback. Supabase then
#      completes the exchange and redirects the user to the application callback URL below.
#
# 2. Supabase Dashboard > Authentication > URL Configuration:
#    - Set "Site URL" to your AWS EC2 deployment origin:
#        http://16.113.92.222 (or https://your-domain.com)
#    - Under "Redirect URLs", ADD the following entries:
#        http://16.113.92.222/**
#        http://16.113.92.222/auth/callback
#        https://your-domain.com/auth/callback (production)
#        http://localhost:3000/** (local dev)
#      If the Redirect URLs allowlist does not contain the EC2 address, Supabase GoTrue
#      will reject the redirect_to parameter and fall back to the project Site URL.
#
# 3. Production HTTPS Requirement:
#    - For production, HTTPS and a custom domain are mandatory.
#    - Google OAuth and modern browser secure cookie policies require HTTPS for production domains.
