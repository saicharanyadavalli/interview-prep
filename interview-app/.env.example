# ============================================================
# Interview Practice Platform - Root Deployment Environment Template
# Place as interview-app/.env on your EC2 host instance
# ============================================================

# ── 1. Google Gemini AI Service ─────────────────────────────
# Required for the AI doubt-clearing assistant (/assistant/ask)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── 2. Supabase Cloud (Database & Authentication) ───────────
# Required for PostgreSQL tables, RLS, and user authentication
# Get from: Supabase Dashboard > Project Settings > API
# ⚠️ Make sure your project is ACTIVE (unpaused) before deploying
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ── 3. Google OAuth ─────────────────────────────────────────
# Required for Google Social Login (Optional if using email/password only)
# Get from: Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── 4. Cloudinary (Media Storage) ───────────────────────────
# Required for system design diagrams and avatar uploads
# Get from: Cloudinary Dashboard
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── 5. Host Networking, CORS & URLs ─────────────────────────
# The public address where users access your application
# For initial testing: http://<EC2_PUBLIC_IP> (e.g., http://13.200.50.25)
# For production with SSL: https://your-domain.com
FRONTEND_URL=http://<EC2_PUBLIC_IP>

# Comma-separated list of allowed origins for FastAPI CORS
ALLOWED_ORIGINS=http://<EC2_PUBLIC_IP>,http://localhost:3000,http://127.0.0.1:3000

# Client browser API base path (relative path routed via Nginx /api/backend)
NEXT_PUBLIC_API_BASE_URL=/api/backend

# Frontend client-side Supabase credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Uvicorn worker count on EC2 (recommended: 2 for t3.small / t4g.small)
UVICORN_WORKERS=2
