# ============================================================
# Next.js Frontend - Environment Variables Template
# Copy to .env.local for local frontend development or test
# ============================================================

# ── API Backend URL ─────────────────────────────────────────
# When deployed behind the EC2 Nginx reverse proxy, leave this as /api/backend (relative path).
# For independent local development against a running backend, use http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=/api/backend

# Internal container URL used by Next.js server-side rewrites and BFF proxy (docker-compose sets this automatically)
BACKEND_INTERNAL_URL=http://backend:8000

# ── Amazon Cognito Authentication ───────────────────────────
# Authoritative authentication config for Cognito User Pool & Hosted UI.
# Used by Next.js BFF proxy routes (server-side) and client auth provider.
#
# Personal Environment:
#   COGNITO_REGION=ap-south-2
#   COGNITO_USER_POOL_ID=ap-south-2_xxxxxxxxx
#   COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
#   COGNITO_DOMAIN=interview-prep-auth-personal.auth.ap-south-2.amazoncognito.com
# Production Environment:
#   COGNITO_REGION=ap-south-2
#   COGNITO_USER_POOL_ID=ap-south-2_yyyyyyyyy
#   COGNITO_CLIENT_ID=yyyyyyyyyyyyyyyyyyyyyyyyyy
#   COGNITO_DOMAIN=auth.interviewprep.com (or interview-prep-auth.auth.ap-south-2.amazoncognito.com)
COGNITO_REGION=ap-south-2
COGNITO_USER_POOL_ID=ap-south-2_yourUserPoolId
COGNITO_CLIENT_ID=your_cognito_app_client_id
COGNITO_DOMAIN=your-cognito-domain.auth.ap-south-2.amazoncognito.com
PUBLIC_APP_ORIGIN=http://localhost:3000

# ── Authentication Redirect & Origin URLs ───────────────────
# Canonical redirect URL for Cognito OAuth Hosted UI callbacks and local dev.
AUTH_REDIRECT_URL=http://localhost:3000/auth/callback?next=/dashboard
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_REDIRECT_URL=http://localhost:3000/auth/callback?next=/dashboard
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Obsolete Supabase Auth (REMOVED) ────────────────────────
# Supabase Auth has been migrated to Amazon Cognito.
# Obsolete variables (NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY, NEXT_PUBLIC_DISABLE_AUTH)
# have been removed from active configuration.

# ── CloudFront CDN Asset Delivery (Optional) ────────────────
# CDN distribution base URL for static assets and profile avatars.
# Personal distribution: https://<your-distribution-id>.cloudfront.net
# Production distribution: https://<your-production-distribution-id>.cloudfront.net
# ⚠️ STRICT RULE: Do NOT use fictitious placeholder domains or unverified distribution URLs.
# NEXT_PUBLIC_ASSET_BASE_URL=https://<your-distribution-id>.cloudfront.net
