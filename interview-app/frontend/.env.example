# ============================================================
# Next.js Frontend - Environment Variables Template
# Copy to .env.local for local frontend development or test
# ============================================================

# ── API Backend URL ─────────────────────────────────────────
# When deployed behind the EC2 Nginx reverse proxy, leave this as /api/backend (relative path).
# For independent local development against a running backend, use http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=/api/backend

# Internal container URL used by Next.js server-side rewrites (docker-compose sets this automatically)
BACKEND_INTERNAL_URL=http://backend:8000

# ── Supabase Cloud Database & Authentication ────────────────
# Get these values from your Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Development / Testing Flags ─────────────────────────────
# Set to "true" ONLY for offline UI smoke testing without a live Supabase project
NEXT_PUBLIC_DISABLE_AUTH=false

# ── Authentication Redirect URL ─────────────────────────────
# Server-side redirect URL for Supabase Auth email confirmation and callbacks.
# Local development: http://localhost:3000/auth/callback?next=/dashboard
# EC2 Deployment: http://16.113.92.222/auth/callback?next=/dashboard
# Vercel Deployment: https://interview-prep-saicharanyadavallis-projects.vercel.app/auth/callback?next=/dashboard
AUTH_REDIRECT_URL=http://localhost:3000/auth/callback?next=/dashboard
