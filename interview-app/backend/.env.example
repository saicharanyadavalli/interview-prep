# ============================================
# Interview Practice Platform - Backend Environment Variables
# Copy to .env inside backend/
# ============================================

# ==========================================
# REQUIRED - AI Service
# ==========================================
# Google Gemini API Key (from Google AI Studio)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# REQUIRED - Amazon Cognito User Pool & Authentication
# ==========================================
# AWS Region for Cognito User Pool (defaults to AWS_REGION if unset)
COGNITO_REGION=ap-south-2

# Cognito User Pool ID (e.g. ap-south-2_xxxxxxxxx)
# Personal: ap-south-2_xxxxxxxxx
# Production: ap-south-2_yyyyyyyyy
COGNITO_USER_POOL_ID=ap-south-2_yourUserPoolId

# Cognito App Client ID (public web client with PKCE)
COGNITO_CLIENT_ID=your_cognito_app_client_id

# Cognito Domain for Hosted UI / OAuth token exchange
# Personal: interview-prep-auth-personal.auth.ap-south-2.amazoncognito.com
# Production: auth.interviewprep.com (or interview-prep-auth.auth.ap-south-2.amazoncognito.com)
COGNITO_DOMAIN=your-cognito-domain.auth.ap-south-2.amazoncognito.com

# ==========================================
# OBSOLETE / REMOVED - Supabase Authentication
# ==========================================
# ⚠️ DEPRECATED & REMOVED: Supabase Auth has been completely migrated to Amazon Cognito.
# These variables are obsolete and no longer used in active runtime.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_KEY=

# ==========================================
# REQUIRED - Amazon RDS PostgreSQL & AWS Secrets Manager
# ==========================================
# AWS Region for RDS and Secrets Manager
AWS_REGION=ap-south-2

# AWS Secrets Manager Secret Name containing RDS credentials
RDS_SECRET_NAME=interview-prep/rds/app
# Optional: Fully qualified secret ARN (defaults to resolving by RDS_SECRET_NAME)
# RDS_SECRET_ARN=arn:aws:secretsmanager:<region>:<account-id>:secret:<secret-name>

# Database Connection Pool Tuning
RDS_POOL_MIN=2
RDS_POOL_MAX=10

# Deployment environment stage: personal, staging, or production (affects cache namespaces & secret names)
ENVIRONMENT=personal

# Optional: Local / CI Database URL override
# DATABASE_URL=postgresql://<db_user>:<db_password>@localhost:5432/interview_prep_db

# ==========================================
# OPTIONAL - Amazon ElastiCache (Valkey / Redis OSS) & Rate Limiting
# ==========================================
# Distributed in-memory caching and atomic rate limiting across Uvicorn workers.
# Co-located in private subnets in AWS ap-south-2 (Hyderabad).
# On AWS EC2, credentials are dynamically resolved from Secrets Manager using the instance IAM role.
#
# Configuration Patterns:
#
# a) Local Development with Local Redis Container:
#    # CACHE_URL can be left unset (Docker Compose automatically defaults to redis://redis:6379/0)
#    # or explicitly set:
#    CACHE_ENABLED=true
#    CACHE_URL=redis://redis:6379/0
#    CACHE_DB=0
#    RATE_LIMIT_STORAGE_URI=   # Leave blank to automatically inherit CACHE_URL (or set to memory://)
#
# b) EC2 Staging/Production with Valkey (Amazon ElastiCache Serverless / Node):
#    ENVIRONMENT=personal
#    AWS_REGION=ap-south-2
#    CACHE_ENABLED=true
#    CACHE_URL=
#    CACHE_HOST=master.interview-prep-node-personal.gmgjlz.aps2.cache.amazonaws.com
#    CACHE_PORT=6379
#    CACHE_TLS_ENABLED=true
#    CACHE_SECRET_NAME=interview-prep/elasticache/auth-personal
#    CACHE_DB=0
#    RATE_LIMIT_STORAGE_URI=
#    CACHE_KEY_PREFIX=ip:personal:cache:v1:
#    RATE_LIMIT_KEY_PREFIX=ip:personal:rl:
#
#    CRITICAL NOTE:
#    CACHE_URL MUST be explicitly empty (CACHE_URL=) to allow host-based Valkey configuration
#    (CACHE_HOST) and AWS Secrets Manager dynamic token resolution (CACHE_SECRET_NAME).
#    When RATE_LIMIT_STORAGE_URI is explicitly empty, it automatically inherits the Valkey endpoint
#    and auth token resolved from Secrets Manager.
#    CACHE_DB is explicitly set to 0 (logical database 0 is required for Valkey / ElastiCache clusters).
CACHE_ENABLED=false
CACHE_HOST=localhost
CACHE_PORT=6379
CACHE_URL=redis://localhost:6379/0
CACHE_TLS_ENABLED=false
CACHE_SECRET_NAME=interview-prep/elasticache/auth-personal
CACHE_DB=0
RATE_LIMIT_STORAGE_URI=
CACHE_KEY_PREFIX=ip:personal:cache:v1:
RATE_LIMIT_KEY_PREFIX=ip:personal:rl:

# ==========================================
# REQUIRED - Google OAuth
# ==========================================
# Google OAuth Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ==========================================
# REQUIRED - AWS S3 & Amazon CloudFront (Asset Storage)
# ==========================================
# Authoritative S3 bucket and CloudFront CDN for profile avatars and system design diagrams.
# On AWS EC2, the backend accesses S3 using the IAM instance role (InterviewPrepEC2Role).
#
# Staging vs. Production Guidelines:
# - Personal Bucket: interview-prep-assets-808431466075-personal-ap-south-2
# - Production Bucket: interview-prep-assets-808431466075-production-ap-south-2
# - ASSET_BASE_URL: Actual HTTPS distribution domain (e.g. https://<your-distribution-id>.cloudfront.net)
#   ⚠️ STRICT RULE: Never use fictitious placeholder hostnames or unverified distribution URLs.
#   In personal/production, missing or invalid ASSET_BASE_URL will fail fast at runtime.
S3_ASSETS_BUCKET=interview-prep-assets-808431466075-personal-ap-south-2
S3_ASSETS_REGION=ap-south-2
ASSET_BASE_URL=https://<your-distribution-id>.cloudfront.net

# Optional folder prefixes (defaults shown)
S3_AVATAR_PREFIX=avatars
S3_SYSTEM_DESIGN_PREFIX=system-design

# ==========================================
# DEPRECATED - Cloudinary (Legacy Image Storage)
# ==========================================
# Replaced by Amazon S3 + CloudFront CDN. Retained only for legacy fallback.
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# CLOUDINARY_AVATAR_FOLDER=interview-prep/avatars
# CLOUDINARY_SYSTEM_DESIGN_FOLDER=interview-prep/system-design

# ==========================================
# CORS & Networking
# ==========================================
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PORT=8000

# ==========================================
# LeetCode Synchronization Pipeline (AWS Lambda -> SQS -> Worker)
# ==========================================
LEETCODE_SYNC_QUEUE_URL=
LEETCODE_SOURCE_REPO=doocs/leetcode
LEETCODE_SOURCE_BRANCH=main
LEETCODE_QUESTIONS_PATH=solution
GITHUB_TOKEN_SECRET_ARN=
