# ============================================
# Interview Practice Platform - Backend Environment Variables
# Copy to .env inside backend/
# ============================================

# ==========================================
# REQUIRED - AI Service
# ==========================================
# Google Gemini API Key (from Google AI Studio)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# REQUIRED - Supabase Auth Only
# ==========================================
# Supabase Project URL (from Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key (safe for frontend - from Project Settings > API)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service role key (SECRET - from Project Settings > API)
# ⚠️ NEVER expose this in frontend code
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ==========================================
# REQUIRED - Amazon RDS PostgreSQL & AWS Secrets Manager
# ==========================================
# AWS Region for RDS and Secrets Manager
AWS_REGION=ap-south-2

# AWS Secrets Manager Secret Name containing RDS credentials
RDS_SECRET_NAME=interview-prep/rds/app
# Optional: Fully qualified secret ARN (defaults to resolving by RDS_SECRET_NAME)
# RDS_SECRET_ARN=arn:aws:secretsmanager:<region>:<account-id>:secret:<secret-name>

# Database Connection Pool Tuning
RDS_POOL_MIN=2
RDS_POOL_MAX=10

# Optional: Local / CI Database URL override
# DATABASE_URL=postgresql://user:pass@localhost:5432/interview_prep_db

# ==========================================
# REQUIRED - Google OAuth
# ==========================================
# Google OAuth Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ==========================================
# REQUIRED - Cloudinary (Image Storage)
# ==========================================
# Cloudinary credentials (from Cloudinary Dashboard)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional folder paths (defaults shown)
CLOUDINARY_AVATAR_FOLDER=interview-prep/avatars
CLOUDINARY_SYSTEM_DESIGN_FOLDER=interview-prep/system-design

# ==========================================
# CORS & Networking
# ==========================================
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PORT=8000